{
  "name": "cardnest",
  "main": "expo-router/entry",
  "version": "0.1.3-alpha-c9085",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "env:check": "node ./scripts/validate-env.mjs",
    "assets:brand": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-brand-assets.ps1",
    "db:types": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/generate-database-types.ps1",
    "db:verify": "node ./scripts/verify-supabase.mjs",
    "db:verify-delete-account": "node ./scripts/verify-account-deletion.mjs",
    "auth:configure": "node ./scripts/configure-supabase-auth.mjs",
    "auth:verify": "node ./scripts/configure-supabase-auth.mjs --verify-only",
    "auth:flow-verify": "node ./scripts/verify-auth-flow.mjs",
    "auth:web-flow-verify": "node ./scripts/verify-web-auth-callback.mjs",
    "auth:production-verify": "node ./scripts/verify-production-auth-flows.mjs",
    "security:verify-bundle": "node ./scripts/verify-no-secret-bundle.mjs",
    "security:verify-repository": "node ./scripts/verify-repository-secrets.mjs",
    "web:install": "npm ci --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:lint": "npm run lint --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "web:build": "npm run build --prefix web",
    "web:check": "npm run web:lint && npm run web:typecheck && npm run web:build",
    "check": "npm run env:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~54.0.35",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-contacts": "~15.0.11",
    "expo-crypto": "~15.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.12",
    "expo-network": "~8.0.8",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-passkeys": "^0.4.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "supabase": "^2.111.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
