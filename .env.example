# Card Nest environment template
# Copy this file to `.env` and fill in real values.
#
# Only EXPO_PUBLIC_* values are bundled into the mobile app. Never place
# service-role keys, database passwords, access tokens, or SMTP credentials
# in EXPO_PUBLIC_* variables.

# Mobile-safe application configuration
EXPO_PUBLIC_APP_NAME=Card Nest
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_APP_SCHEME=cardnest
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPPORT_EMAIL=cardnest@YOUR_VERIFIED_DOMAIN
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Trusted local tooling only — never import these from Expo application code
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=YOUR_SUPABASE_PERSONAL_ACCESS_TOKEN
SUPABASE_DB_PASSWORD=YOUR_DATABASE_PASSWORD
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_DB_URL=
SUPABASE_POOLER_URL=

# Postmark / SMTP — trusted backend or admin tooling only
POSTMARK_SERVER_TOKEN=YOUR_POSTMARK_SERVER_TOKEN
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
SMTP_USER=YOUR_POSTMARK_SMTP_USERNAME
SMTP_PASS=YOUR_POSTMARK_SMTP_PASSWORD
SMTP_FROM_EMAIL=cardnest@YOUR_VERIFIED_DOMAIN
SMTP_FROM_NAME=Card Nest

# Card Nest is BYOK. User OpenAI or Gemini API keys belong in Expo SecureStore,
# not in this file and never in EXPO_PUBLIC_* variables.

# Production website
# The initial web app requires no secrets or public runtime variables.
# Its canonical origin is fixed to https://cardnest.ytosko.dev.
