{
  "expo": {
    "name": "Card Nest",
    "slug": "cardnest",
    "description": "Scan, organize, and safely back up the business cards worth keeping.",
    "version": "0.1.2-alpha-f9801",
    "orientation": "portrait",
    "icon": "./assets/images/cardnest-icon.png",
    "scheme": "cardnest",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F7FBFC",
    "primaryColor": "#0CC0DF",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.ytosko.cardnest",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "dev.ytosko.cardnest",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#0CC0DF",
        "foregroundImage": "./assets/images/cardnest-adaptive-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/cardnest-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/cardnest-splash.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7FBFC",
          "dark": {
            "image": "./assets/images/cardnest-splash.png",
            "backgroundColor": "#071417"
          }
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Card Nest to photograph business cards for your private library."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Card Nest to save selected business cards to your contacts."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Card Nest to choose business card and profile images from your library."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9f82f370-745c-49b7-8439-d09451a484d8"
      }
    },
    "owner": "ytoskos-team"
  }
}
